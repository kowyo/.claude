{
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "attribution": {
    "pr": ""
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "sh $HOME/.claude/statusline-command.sh"
  },
  "extraKnownMarketplaces": {},
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 400000
    }
  },
  "autoMemoryEnabled": false,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": false,
  "theme": "auto",
  "disableDeepLinkRegistration": "disable",
  "language": "chinese",
  "deniedMcpServers": [
    {
      "serverName": "claude.ai ChEMBL"
    },
    {
      "serverName": "claude.ai Clinical Trials"
    },
    {
      "serverName": "claude.ai Higgsfield AI"
    },
    {
      "serverName": "claude.ai bioRxiv"
    },
    {
      "serverName": "claude.ai katana"
    },
    {
      "serverName": "higgsfield"
    }
  ]
}
